rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // climbLog: done, wishlist; sync tussen apparaten via doneUpdatedAt / wishlistUpdatedAt (LWW per veld)
    match /users/{userId}/climbLog/{entryId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/prefs/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/integrations/{doc} {
      allow read, write: if false;
    }
    // Phase 3 Strava server-sync: status lezen in Instellingen; schrijven alleen via Functions.
    match /users/{userId}/stravaSyncJobs/{jobId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
    match /stravaOAuthStates/{stateId} {
      allow read, write: if false;
    }
  }
}
